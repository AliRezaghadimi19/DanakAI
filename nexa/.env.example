NEXA_TIME_ZONE=Asia/Tehran
NEXA_LDAP_BIND_PASSWORD=
NEXA_MODEL_KEY=
# Public deployment behind a TLS-terminating proxy (comma-separated lists).
NEXA_ALLOWED_HOSTS=localhost,127.0.0.1
NEXA_CSRF_TRUSTED_ORIGINS=
NEXA_PROXY_SSL_HEADER=0
NEXA_HTTPS=0
NEXA_HSTS_SECONDS=0
# Failed logins per account within the window; per-address limit is off (0) by default.
NEXA_LOGIN_MAX_ATTEMPTS=5
NEXA_LOGIN_MAX_ATTEMPTS_PER_ADDRESS=0
NEXA_LOGIN_WINDOW_SECONDS=900
NEXA_WORKERS=2
NEXA_THREADS=8
NEXA_LOG_LEVEL=INFO

# Maximum pending (unapproved) uploads per user
NEXA_MAX_PENDING_UPLOADS=10
